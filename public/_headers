# Kartsida (/kart) laster raster-/vektorfliser direkte fra Kartverkets
# fliseserver (cache.kartverket.no). Dette er et bevisst unntak fra «alt er
# 'self'»: å selvhoste hele flisekatalogen er ikke praktisk, og flisene er
# åpne data (CC BY 4.0/NLOD). CSP-en åpnes derfor bare for den konkrete
# fliseverten — aldri med *. Se også docs/KART.md.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://cache.kartverket.no; font-src 'self'; connect-src 'self' https://cache.kartverket.no; form-action 'self'; frame-ancestors 'none'; base-uri 'self'

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/img/*
  Cache-Control: public, max-age=604800

/assets/css/*
  Cache-Control: public, max-age=86400

/assets/js/*
  Cache-Control: public, max-age=86400

/data/*
  Cache-Control: public, max-age=300
